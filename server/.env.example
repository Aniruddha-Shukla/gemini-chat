# Copy this file to `.env` and fill in the values. Never commit `.env`.

# ---- Server ----
# Avoid 5000 on macOS: the AirPlay Receiver already listens there.
PORT=4000
NODE_ENV=development
# Origin allowed by CORS (the Vite dev server in development)
CLIENT_URL=http://localhost:5173
# Number of reverse proxies in front of the API (0 locally; usually 1 behind nginx/Render/Railway)
TRUST_PROXY=0

# ---- MongoDB ----
# Leave empty in development: the server then starts a built-in local MongoDB
# (nothing to install; data is kept in server/.data/db). Required in production.
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/gemini-chat
MONGODB_URI=

# ---- Auth ----
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- Google Gemini ----
# Create a key at https://aistudio.google.com/apikey
# This key stays on the server and is never sent to the browser.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
